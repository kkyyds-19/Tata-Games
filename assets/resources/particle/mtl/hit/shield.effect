CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        mainTexture: { value: white }
        alphaThreshold: { value: 0.5 }
        u_color: { value: [1,1,1,1], editor: {type: color} }
        u_rate: { value: 1 }
        shield_color: { value: [0,0.5,1,1], editor: {type: color, tooltip: "防护盾颜色"} }
        shield_intensity: { value: 1.0, editor: {type: float, tooltip: "防护盾强度"} }
        shield_pulse: { value: 2.0, editor: {type: float, tooltip: "防护盾脉冲速度"} }
        shield_radius: { value: 0.8, editor: {type: float, tooltip: "防护盾半径"} }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 v_light;

  out vec4 color;
  out vec2 uv0;

  #if USE_TINT
    in vec4 a_color0;
    out vec4 v_dark;
  #endif

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    mat4 mvp;
    #if CC_USE_MODEL
      mvp = cc_matViewProj * cc_matWorld;
    #else
      mvp = cc_matViewProj;
    #endif

    v_light = a_color;
    #if USE_TINT
      v_dark = a_color0;
    #endif

    pos = mvp * vec4(a_position, 1);
    uv0 = a_texCoord;
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  #include <builtin/uniforms/cc-global>

  in vec4 color;
  in vec4 v_light;

  #if USE_TINT
    in vec4 v_dark;
  #endif

  #if USE_TEXTURE
    in vec2 uv0;
    uniform sampler2D mainTexture;
    #pragma builtin(local)
    layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;
  #endif

  uniform ARGS {
    vec4 u_color;
    vec4 shield_color;
    float u_rate;
    float shield_intensity;
    float shield_pulse;
    float shield_radius;
  };

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    #endif
    
    vec4 finalColor;
    #if USE_TINT
      finalColor.a = v_light.a * o.a;
      finalColor.rgb = ((o.a - 1.0) * v_dark.a + 1.0 - o.rgb) * v_dark.rgb + o.rgb * v_light.rgb;
    #else
      finalColor = o * v_light;
    #endif

    ALPHA_TEST(finalColor);
    
    // 计算防护盾效果
    vec2 center = vec2(0.5, 0.5);
    vec2 uv = uv0 - center;
    float dist = length(uv);
    
    // 使用cc_time.x自动循环动画
    float time = cc_time.x;
    
    // 创建多层防护盾效果
    float shield_layer1 = smoothstep(shield_radius, shield_radius - 0.15, dist);
    float shield_layer2 = smoothstep(shield_radius - 0.05, shield_radius - 0.25, dist);
    
    // 自动循环脉冲动画
    float pulse1 = sin(time * shield_pulse) * 0.4 + 0.6;
    float pulse2 = sin(time * shield_pulse * 1.5) * 0.3 + 0.7;
    
    shield_layer1 *= pulse1;
    shield_layer2 *= pulse2;
    
    // 合并防护盾层
    float shield_effect = max(shield_layer1, shield_layer2 * 0.8);
    
    // 添加边缘发光效果
    float edge_glow = smoothstep(shield_radius + 0.1, shield_radius - 0.1, dist);
    edge_glow = pow(edge_glow, 1.5);
    
    // 直接使用防护盾颜色，不与背景融合
    vec3 shield_rgb = shield_color.rgb * shield_intensity;
    vec3 result = mix(finalColor.rgb, shield_rgb, shield_effect * shield_color.a);
    result += shield_rgb * edge_glow * 0.6; // 边缘发光
    
    o = vec4(result.rgb, finalColor.a);
    return o;
  }
}% 